# These values are checked when the app starts (src/instrumentation.ts).
# Anything missing or malformed is named in the startup log with what to do
# about it. A correctly configured install logs a single line, naming the
# addresses it treats as reverse proxies (see TRUSTED_PROXIES below for why
# that one is always printed). DATABASE_URL and JWT_SECRET are treated as
# fatal — without either, no page can be served, so the app stops and says so
# rather than returning unexplained 500s later. Note that it stops without
# exiting: the service still looks "running" and static files are still
# served, so read the log rather than the service status.

# Required. PostgreSQL connection string.
DATABASE_URL="postgresql://tracker:<STRONG_PASSWORD_HERE>@localhost:5432/training_tracker"

# Required. Signs and verifies session cookies. Minimum 32 characters —
# generate with: openssl rand -hex 32
JWT_SECRET="<GENERATE_RANDOM_64_CHARACTER_SECRET>"

# Optional: maximum PostgreSQL connections in the app's connection pool.
# Defaults to 20. Raise it if many users run heavy reports concurrently (and
# your PostgreSQL max_connections allows it); lower it on very small servers.
# DATABASE_POOL_MAX="20"

# Required to encrypt secrets at rest (TOTP shared secrets, OAuth refresh
# tokens, SMTP passwords) and backup archives. Must be exactly 64 hex
# characters — generate with: openssl rand -hex 32
# WITHOUT IT, OR WITH A MALFORMED VALUE, THOSE SECRETS ARE WRITTEN TO THE
# DATABASE IN PLAINTEXT. That used to happen silently; the startup check now
# warns about it, but the warning is not a substitute for setting the key.
# After setting, run POST /api/admin/security/encrypt-secrets (SuperAdmin)
# once to seal any pre-existing rows.
ENCRYPTION_KEY="<GENERATE_RANDOM_64_CHARACTER_HEX>"

# Required for cron-based auto-backup, scheduled exports and the daily
# credential health check. Generate with: openssl rand -hex 32
# Without it every scheduled job is rejected with the same 401 a forged
# signature gets — i.e. the jobs simply never run. The startup check warns.
# CRON_SECRET="<GENERATE_RANDOM_HEX_SECRET>"

# Canonical externally-resolvable origin of this deployment, e.g.
# https://tracker.example.com — used to build OAuth callback URLs without
# trusting attacker-controllable X-Forwarded-Host headers.
# APP_BASE_URL="https://tracker.example.com"

# Comma-separated list of trusted reverse-proxy IPs. Their X-Forwarded-For
# entries are stripped when extracting the real client IP for rate
# limiting. Defaults to loopback — set to your proxy's address(es) when
# fronted by something other than localhost. Blanking the value does NOT mean
# "trust nothing"; it falls back to the loopback default, because trusting
# nothing makes the proxy's own address the answer for every client.
#
# Only plain IPv4/IPv6 literals are matched: CIDR ranges and hostnames are NOT
# supported and are ignored with a warning. Equivalent spellings of the same
# IPv6 address are matched (::1 and 0:0:0:0:0:0:0:1 are the same address here),
# but an IPv4-mapped address is NOT the same as the plain IPv4 one —
# ::ffff:127.0.0.1 does not match a 127.0.0.1 entry, so list both spellings if
# your proxy presents the mapped form.
#
# Getting this wrong is quiet. If your proxy's address is missing from the
# list, that address is returned as "the client" for everyone behind it, so
# per-IP rate limits count all of your users as one — and the app cannot
# detect this, because with a single proxy that sets X-Forwarded-For a correct
# deployment looks exactly the same from the inside. Every production start
# therefore logs the addresses actually being trusted, set or not; compare that
# line against your real topology, because it is the only check there is.
#
# Two related cases ARE detected and warned about once per start: nothing in
# front of the app setting X-Forwarded-For at all, and a proxy that appends
# something unreadable instead of an address (Squid with `forwarded_for off`
# appends the literal `unknown`). In both, every caller shares one bucket —
# the walk stops rather than trusting whatever a client put further left.
# TRUSTED_PROXIES="127.0.0.1,::1"

# Needed when this host is behind an SSL-inspecting proxy/firewall (e.g. Palo
# Alto): Node ignores the system trust store, so point it at the CA bundle that
# includes your firewall's root cert. The installer sets this automatically on
# Debian. Generate the bundle with: update-ca-certificates
# NODE_EXTRA_CA_CERTS="/etc/ssl/certs/ca-certificates.crt"

# Optional: folder that scheduled exports delivered to the local filesystem may
# write into. Defaults to <app dir>/exports. A schedule pointing anywhere else
# is refused, so an Admin cannot make the server write outside this tree.
# On a systemd host, a value outside /opt/training-tracker also needs a matching
# ReadWritePaths= drop-in, or the sandbox will block the write.
# EXPORT_ROOT="/opt/training-tracker/exports"

# Optional: folder that backup archives are written to and that the folder
# picker on the Backup page may browse. Defaults to <app dir>/backups, with the
# same ReadWritePaths= caveat as EXPORT_ROOT.
# BACKUP_ROOT="/opt/training-tracker/backups"

# Optional: maximum size (in MB) of a backup archive accepted by the restore
# upload, checked before the file is read into memory. Defaults to 512. Raise it
# only if a legitimate full backup of your dataset exceeds this.
# BACKUP_MAX_RESTORE_MB="512"

# Optional: maximum size (in MB) that a backup archive's *contents* may unpack
# to, checked as soon as the archive is opened and before any entry is read.
# Defaults to 1024. This is a separate limit from BACKUP_MAX_RESTORE_MB above,
# which bounds the file as it arrives: a small file can be crafted to expand
# enormously, and only this check catches that. A genuine backup is stored
# uncompressed, so real archives sit far below both limits.
# BACKUP_MAX_EXPANDED_MB="1024"

# Optional: maximum size (in MB) of a JSON body accepted by the bulk-import
# endpoints, checked before the body is buffered and parsed. Defaults to 32.
# IMPORT_MAX_BODY_MB="32"

# Optional: Required for update checks AND git pulls on private GitHub repositories
# GITHUB_TOKEN="ghp_your-personal-access-token"
# Update channel: "stable" (default, production releases only) or "dev" (includes pre-releases)
# UPDATE_CHANNEL="stable"
