DATABASE_URL="postgresql://tracker:<STRONG_PASSWORD_HERE>@localhost:5432/training_tracker"
JWT_SECRET="<GENERATE_RANDOM_64_CHARACTER_SECRET>"

# Optional: maximum PostgreSQL connections in the app's connection pool.
# Defaults to 20. Raise it if many users run heavy reports concurrently (and
# your PostgreSQL max_connections allows it); lower it on very small servers.
# DATABASE_POOL_MAX="20"

# Required to encrypt secrets at rest (TOTP shared secrets, OAuth refresh
# tokens, SMTP passwords). Generate with: openssl rand -hex 32
# After setting, run POST /api/admin/security/encrypt-secrets (SuperAdmin)
# once to seal any pre-existing rows.
ENCRYPTION_KEY="<GENERATE_RANDOM_64_CHARACTER_HEX>"

# Required for cron-based auto-backup and scheduled exports authentication
# Generate with: openssl rand -hex 32
# CRON_SECRET="<GENERATE_RANDOM_HEX_SECRET>"

# Canonical externally-resolvable origin of this deployment, e.g.
# https://tracker.example.com — used to build OAuth callback URLs without
# trusting attacker-controllable X-Forwarded-Host headers.
# APP_BASE_URL="https://tracker.example.com"

# Comma-separated list of trusted reverse-proxy IPs. Their X-Forwarded-For
# entries are stripped when extracting the real client IP for rate
# limiting. Defaults to loopback — set to your proxy's address(es) when
# fronted by something other than localhost.
# TRUSTED_PROXIES="127.0.0.1,::1"

# Needed when this host is behind an SSL-inspecting proxy/firewall (e.g. Palo
# Alto): Node ignores the system trust store, so point it at the CA bundle that
# includes your firewall's root cert. The installer sets this automatically on
# Debian. Generate the bundle with: update-ca-certificates
# NODE_EXTRA_CA_CERTS="/etc/ssl/certs/ca-certificates.crt"

# Optional: Required for update checks AND git pulls on private GitHub repositories
# GITHUB_TOKEN="ghp_your-personal-access-token"
# Update channel: "stable" (default, production releases only) or "dev" (includes pre-releases)
# UPDATE_CHANNEL="stable"
