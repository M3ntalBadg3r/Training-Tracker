[Unit]
Description=Training Tracker Next.js Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=training-tracker
Group=training-tracker
WorkingDirectory=/opt/training-tracker
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/opt/training-tracker/.env

# --- Sandboxing -------------------------------------------------------------
# The app is unprivileged and is granted no escalation path: privileged work
# (updates, service restarts) is requested by writing /opt/training-tracker/
# .update-request, which the root-owned training-tracker-update.path unit picks
# up and validates. There is deliberately no sudoers rule, setuid helper or
# polkit rule anywhere in this project.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/training-tracker
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# Do NOT add MemoryDenyWriteExecute=yes here. It appears in most systemd
# hardening checklists, but it blocks V8's JIT and the app will fail to start.
#
# PORT above is 3000, so no capability is needed to bind it. If you lower PORT
# below 1024 you must also add:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Putting a reverse proxy in front and leaving PORT alone is preferred.

[Install]
WantedBy=multi-user.target
