generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TrainingType {
  Certification
  Accreditation
  InstructorLedTraining @map("Instructor-Led Training")
  OLX
  OLXSubItem            @map("OLX Sub-Item")
}

enum FunctionType {
  Sales
  PreSales    @map("Pre-Sales")
  Deployments
}

model Student {
  email      String          @id
  fullName   String          @map("full_name")
  theatre    String
  country    String
  companyId  Int             @map("company_id")
  regionData RegionData?     @relation(fields: [country], references: [country])
  company    Company         @relation(fields: [companyId], references: [id])
  trainings  TrainingTaken[]

  @@index([companyId])
  @@index([country])
  @@index([theatre])
  @@map("students")
}

model Company {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  students         Student[]
  users            UserCompany[]
  scheduledExports ScheduledExport[]
  apiKeys          ApiKeyCompany[]
  offerings        Offering[]

  @@map("companies")
}

model UserCompany {
  userId    Int     @map("user_id")
  companyId Int     @map("company_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

model TrainingTaken {
  id            Int      @id @default(autoincrement())
  email         String
  trainingTitle String   @map("training_title")
  completedDate DateTime @map("completed_date")
  expiryDate    DateTime @map("expiry_date")

  student      Student      @relation(fields: [email], references: [email], onDelete: Cascade)
  trainingData TrainingData @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)

  @@index([email])
  @@index([trainingTitle])
  @@index([trainingTitle, expiryDate])
  @@index([trainingTitle, completedDate, expiryDate])
  @@index([trainingTitle, email])
  // Standalone completedDate index for the "achieved in last N months" report,
  // which filters completedDate across all titles (no trainingTitle predicate,
  // so the title-led composite above can't serve it).
  @@index([completedDate])
  @@map("training_taken")
}

model TrainingData {
  trainingTitle String       @id @map("training_title")
  fullTitle     String       @map("full_title")
  trainingType  TrainingType @map("training_type")
  productTypeId Int          @map("product_type_id")
  function      FunctionType
  link          String?
  certification String[]     @default([]) @map("certification")
  isIncomplete  Boolean      @default(false) @map("is_incomplete")
  // Legacy lifecycle (Certification/Accreditation only). When `isLegacy` is set,
  // `replacedBy` lists the trainingTitles of the Cert/Accreditation(s) that
  // supersede this one (alternatives — completing any one counts). Empty means
  // the cert is retired with no replacement.
  isLegacy      Boolean      @default(false) @map("is_legacy")
  replacedBy    String[]     @default([]) @map("replaced_by")

  productType              ProductType               @relation(fields: [productTypeId], references: [id])
  trainingsTaken           TrainingTaken[]
  programData              ProgramData[]
  programDataAlternatives  ProgramDataAlternative[]
  offeringData             OfferingData[]
  offeringDataAlternatives OfferingDataAlternative[]

  // OLX parent ↔ sub-item membership (many-to-many).
  // `parentMemberships` are rows where THIS training is a sub-item that belongs
  // to one or more parent OLX trainings. `subItemMemberships` are rows where
  // THIS training is a parent OLX whose sub-items are listed.
  parentMemberships  OlxSubItemRelation[] @relation("SubItemSide")
  subItemMemberships OlxSubItemRelation[] @relation("ParentSide")

  @@index([fullTitle])
  @@index([productTypeId])
  @@map("training_data")
}

model ProductType {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  color String? @db.VarChar(7)

  trainingData TrainingData[]

  @@map("product_types")
}

// Join table: each row says "the OLX parent <parentTrainingTitle> includes
// the sub-item <subItemTrainingTitle>". A single sub-item may be reused
// across multiple parents.
model OlxSubItemRelation {
  parentTrainingTitle  String @map("parent_training_title")
  subItemTrainingTitle String @map("sub_item_training_title")

  parent  TrainingData @relation("ParentSide", fields: [parentTrainingTitle], references: [trainingTitle], onDelete: Cascade)
  subItem TrainingData @relation("SubItemSide", fields: [subItemTrainingTitle], references: [trainingTitle], onDelete: Cascade)

  @@id([parentTrainingTitle, subItemTrainingTitle])
  @@index([subItemTrainingTitle])
  @@map("olx_sub_item_relations")
}

model RegionData {
  country  String    @id
  region   String
  theatre  String?
  students Student[]

  @@map("region_data")
}

model ImportMetadata {
  key       String   @id
  timestamp DateTime @default(now())

  @@map("import_metadata")
}

enum Role {
  SuperAdmin
  Admin
  User
}

enum ProgramLevel {
  Country
  Theatre
  Global
}

model Program {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  // Tiered programs unlock ordered tiers (A/B/C…) based on how many
  // specialisations a partner has achieved. Non-tiered programs behave exactly
  // as before (isTiered = false).
  isTiered       Boolean  @default(false) @map("is_tiered")
  // How a tier's Deployment cert requirements are sourced when isTiered:
  //  "flat"                    → the tier lists its own deployment requirements.
  //  "perAchievedSpecialisation" → each achieved specialisation's own deployment
  //                                requirements must be met.
  deploymentMode String   @default("flat") @map("deployment_mode")
  createdAt      DateTime @default(now()) @map("created_at")

  tiers ProgramTier[]

  @@map("programs")
}

model ProgramTier {
  id                      Int      @id @default(autoincrement())
  // String mirror of Program.name (kept in sync in application code, like
  // ProgramData.programName). Also a real FK so tiers cascade with the program.
  programName             String   @map("program_name")
  name                    String
  sortOrder               Int      @map("sort_order")
  specialisationsRequired Int      @default(1) @map("specialisations_required")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  program      Program       @relation(fields: [programName], references: [name], onDelete: Cascade)
  requirements ProgramData[]

  @@unique([programName, name])
  @@map("program_tiers")
}

model Specialisation {
  id   Int    @id @default(autoincrement())
  name String @unique

  programData             ProgramData[]
  offeringData            OfferingData[]
  offeringSpecialisations OfferingSpecialisation[]

  @@map("specialisations")
}

model ProgramData {
  id                Int           @id @default(autoincrement())
  programName       String        @map("program_name")
  // A requirement belongs to EITHER a specialisation (specialisationId) OR a
  // tier (tierId) — exactly one is set, enforced in application code. Existing
  // rows all carry a specialisationId, so making it nullable is backward safe.
  specialisationId  Int?          @map("specialisation_id")
  tierId            Int?          @map("tier_id")
  // "qualification" → counts toward achieving the specialisation.
  // "deployment"    → a specialisation's Deployment cert requirement, used by
  //                   tiers running in "perAchievedSpecialisation" mode.
  // Tier-scoped rows (tierId set) are always deployment requirements.
  purpose           String        @default("qualification")
  level             ProgramLevel
  trainingType      TrainingType? @map("training_type")
  trainingTitle     String?       @map("training_title")
  quantityRequired  Int           @map("quantity_required")
  minimumPerTheatre Int?          @map("minimum_per_theatre")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  specialisation Specialisation?          @relation(fields: [specialisationId], references: [id])
  tier           ProgramTier?             @relation(fields: [tierId], references: [id], onDelete: Cascade)
  trainingData   TrainingData?            @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)
  alternatives   ProgramDataAlternative[]

  @@map("program_data")
}

model ProgramDataAlternative {
  id            Int          @id @default(autoincrement())
  programDataId Int          @map("program_data_id")
  trainingType  TrainingType @map("training_type")
  trainingTitle String       @map("training_title")

  programData  ProgramData  @relation(fields: [programDataId], references: [id], onDelete: Cascade)
  trainingData TrainingData @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)

  @@map("program_data_alternatives")
}

// ---------------------------------------------------------------------------
// Offerings — a partner's ability to deliver a joint product offering. Simpler
// than Programs (no tiers, no ProgramLevel, no deployment purpose); each
// requirement belongs to a specialisation and the viewer splits every count
// into Onshore (a selected country/region) and Offshore (the rest of that
// theatre). Unlike Programs, offerings are tenant data: each Offering belongs
// to exactly one Company, so a company has its own set of offerings that only
// users (and API keys) with access to that company can see or manage. Names are
// unique PER COMPANY (@@unique([companyId, name])), so the child join tables
// reference the immutable numeric id rather than the name.
// ---------------------------------------------------------------------------
model Offering {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  name        String
  description String?
  link        String?
  createdAt   DateTime @default(now()) @map("created_at")

  company         Company                  @relation(fields: [companyId], references: [id])
  specialisations OfferingSpecialisation[]
  offeringData    OfferingData[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("offerings")
}

// Persists a "selected but possibly empty" specialisation on an offering, so a
// specialisation section renders on the detail page before any trainings are
// added (unlike Programs, which derive specialisations from requirement rows).
model OfferingSpecialisation {
  offeringId       Int @map("offering_id")
  specialisationId Int @map("specialisation_id")

  offering       Offering       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  specialisation Specialisation @relation(fields: [specialisationId], references: [id], onDelete: Cascade)

  @@id([offeringId, specialisationId])
  @@map("offering_specialisations")
}

model OfferingData {
  id               Int           @id @default(autoincrement())
  offeringId       Int           @map("offering_id")
  specialisationId Int           @map("specialisation_id")
  trainingType     TrainingType? @map("training_type")
  trainingTitle    String?       @map("training_title")
  quantityRequired Int           @map("quantity_required")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  offering       Offering                  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  specialisation Specialisation            @relation(fields: [specialisationId], references: [id])
  trainingData   TrainingData?             @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)
  alternatives   OfferingDataAlternative[]

  @@index([offeringId])
  @@map("offering_data")
}

model OfferingDataAlternative {
  id             Int          @id @default(autoincrement())
  offeringDataId Int          @map("offering_data_id")
  trainingType   TrainingType @map("training_type")
  trainingTitle  String       @map("training_title")

  offeringData OfferingData @relation(fields: [offeringDataId], references: [id], onDelete: Cascade)
  trainingData TrainingData @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)

  @@map("offering_data_alternatives")
}

model User {
  id                  Int           @id @default(autoincrement())
  username            String        @unique
  passwordHash        String        @map("password_hash")
  displayName         String        @map("display_name")
  role                Role          @default(User)
  mfaEnabled          Boolean       @default(false) @map("mfa_enabled")
  mfaSecret           String?       @map("mfa_secret")
  mustEnableMfa       Boolean       @default(false) @map("must_enable_mfa")
  // Brute-force lockout: failedLoginAttempts counts consecutive failed logins
  // (bad password or bad MFA); lockedUntil holds the temporary lock expiry set
  // once the threshold is crossed (see lib/login-attempts.ts). Both reset on a
  // successful login.
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  lastLoginAt         DateTime?     @map("last_login_at")
  lastLoginIp         String?       @map("last_login_ip")
  dateFormat          String?       @map("date_format")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  companies           UserCompany[]

  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdatedBy")

  @@map("users")
}

// Persistent, shared sliding-window rate-limit counters. Backs lib/rate-limit.ts
// so per-IP/per-key limits survive process restarts and are shared across
// instances (the previous limiter was an in-memory Map). One row per limiter
// key (e.g. "login:<ip>", "apikey-fail:<ip>"); `resetAt` is when the current
// window expires and the count rolls back to zero. Expired rows are cleaned up
// opportunistically.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

// Audit log of rejected authentication attempts, surfaced to SuperAdmins on the
// /admin/users (login) and /admin/api-keys (API) pages. Only genuine credential
// attempts are recorded (not requests rejected purely by the rate limiter — those
// would amplify rows under attack and are shown instead as "currently blocked
// IPs" derived from RateLimitBucket). Rows older than 30 days are pruned
// opportunistically. See lib/failed-attempts.ts.
model FailedAttempt {
  id         Int      @id @default(autoincrement())
  kind       String // "login" | "api"
  identifier String // attempted username (login) | masked key prefix (api)
  ip         String
  reason     String // login: bad_password|bad_mfa|unknown_user ; api: invalid_key|disabled_key|revoked_key|expired_key
  keyName    String?  @map("key_name") // api only: name of the known key whose hash matched, if any
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([ip])
  @@map("failed_attempts")
}

// Per-field header alias for the student-import auto-mapper. The wizard
// fetches these at mount and matches each header against the alias list
// (case/punctuation-insensitive). Defaults are seeded by the migration; the
// list is otherwise managed at /admin/system-settings.
model ImportAlias {
  id          Int      @id @default(autoincrement())
  targetField String   @map("target_field")
  alias       String
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([targetField, alias], map: "import_aliases_target_field_alias_key")
  @@index([targetField])
  @@map("import_aliases")
}

// Singleton: always id = 1. Stores system-wide preferences (default date
// format, idle-session timeout, public-API switch). Application code must
// upsert with id: 1; the migration also adds a CHECK constraint as
// defence-in-depth.
model SystemSetting {
  id                 Int      @id @default(1)
  dateFormat         String   @default("DD/MM/YYYY") @map("date_format")
  sessionIdleMinutes Int      @default(30) @map("session_idle_minutes")
  // Global kill switch for the read-only public API (`/api/public/v1/*`).
  // Off by default: the API must be switched on deliberately before any key works.
  publicApiEnabled   Boolean  @default(false) @map("public_api_enabled")
  updatedAt          DateTime @updatedAt @map("updated_at")
  updatedById        Int?     @map("updated_by_id")

  updatedBy User? @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model ScheduledExport {
  id          Int       @id @default(autoincrement())
  name        String
  companyId   Int       @map("company_id")
  reportType  String    @map("report_type")
  format      String
  destination String
  config      Json
  enabled     Boolean   @default(true)
  frequency   String
  time        String
  dayOfWeek   Int?      @map("day_of_week")
  dayOfMonth  Int?      @map("day_of_month")
  lastRunAt   DateTime? @map("last_run_at")
  lastStatus  String?   @map("last_status")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("scheduled_exports")
}

// Read-only public API key. Third-party systems authenticate by sending the
// plaintext key in an `Authorization: Bearer` header; only the SHA-256 hash is
// stored here (never the plaintext, which is shown to the admin exactly once at
// creation). A key reads only the companies linked via ApiKeyCompany.
model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String
  keyPrefix   String    @map("key_prefix")
  keyHash     String    @unique @map("key_hash")
  enabled     Boolean   @default(true)
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  lastUsedIp  String?   @map("last_used_ip")
  revokedAt   DateTime? @map("revoked_at")
  createdById Int?      @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  companies ApiKeyCompany[]

  @@index([keyHash])
  @@map("api_keys")
}

// Join table scoping an ApiKey to the companies whose data it may read.
model ApiKeyCompany {
  apiKeyId  Int @map("api_key_id")
  companyId Int @map("company_id")

  apiKey  ApiKey  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, companyId])
  @@index([companyId])
  @@map("api_key_companies")
}

model ExportCredential {
  id              Int       @id @default(autoincrement())
  provider        String    @unique
  config          Json
  lastCheckedAt   DateTime? @map("last_checked_at")
  lastCheckStatus String?   @map("last_check_status")
  lastCheckError  String?   @map("last_check_error")
  lastSuccessAt   DateTime? @map("last_success_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("export_credentials")
}
