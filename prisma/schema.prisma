generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TrainingType {
  Certification
  Accreditation
  InstructorLedTraining @map("Instructor-Led Training")
  OLX
  OLXSubItem            @map("OLX Sub-Item")
}

enum FunctionType {
  Sales
  PreSales     @map("Pre-Sales")
  Deployments
}

model Student {
  email      String          @id
  fullName   String          @map("full_name")
  theatre    String
  country    String
  companyId  Int             @map("company_id")
  regionData RegionData?     @relation(fields: [country], references: [country])
  company    Company         @relation(fields: [companyId], references: [id])
  trainings  TrainingTaken[]

  @@index([companyId])
  @@map("students")
}

model Company {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  students         Student[]
  users            UserCompany[]
  scheduledExports ScheduledExport[]

  @@map("companies")
}

model UserCompany {
  userId    Int     @map("user_id")
  companyId Int     @map("company_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

model TrainingTaken {
  id            Int          @id @default(autoincrement())
  email         String
  trainingTitle String       @map("training_title")
  completedDate DateTime     @map("completed_date")
  expiryDate    DateTime     @map("expiry_date")

  student      Student      @relation(fields: [email], references: [email], onDelete: Cascade)
  trainingData TrainingData @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)

  @@index([email])
  @@index([trainingTitle])
  @@map("training_taken")
}

model TrainingData {
  trainingTitle String       @id @map("training_title")
  fullTitle     String       @map("full_title")
  trainingType  TrainingType @map("training_type")
  productTypeId Int          @map("product_type_id")
  function      FunctionType
  link          String?
  certification String[]      @default([]) @map("certification")
  isIncomplete  Boolean      @default(false) @map("is_incomplete")

  productType             ProductType  @relation(fields: [productTypeId], references: [id])
  trainingsTaken          TrainingTaken[]
  programData             ProgramData[]
  programDataAlternatives ProgramDataAlternative[]

  // OLX parent ↔ sub-item membership (many-to-many).
  // `parentMemberships` are rows where THIS training is a sub-item that belongs
  // to one or more parent OLX trainings. `subItemMemberships` are rows where
  // THIS training is a parent OLX whose sub-items are listed.
  parentMemberships  OlxSubItemRelation[] @relation("SubItemSide")
  subItemMemberships OlxSubItemRelation[] @relation("ParentSide")

  @@index([fullTitle])
  @@index([productTypeId])
  @@map("training_data")
}

model ProductType {
  id   Int    @id @default(autoincrement())
  name String @unique

  trainingData TrainingData[]

  @@map("product_types")
}

// Join table: each row says "the OLX parent <parentTrainingTitle> includes
// the sub-item <subItemTrainingTitle>". A single sub-item may be reused
// across multiple parents.
model OlxSubItemRelation {
  parentTrainingTitle  String @map("parent_training_title")
  subItemTrainingTitle String @map("sub_item_training_title")

  parent  TrainingData @relation("ParentSide",  fields: [parentTrainingTitle],  references: [trainingTitle], onDelete: Cascade)
  subItem TrainingData @relation("SubItemSide", fields: [subItemTrainingTitle], references: [trainingTitle], onDelete: Cascade)

  @@id([parentTrainingTitle, subItemTrainingTitle])
  @@index([subItemTrainingTitle])
  @@map("olx_sub_item_relations")
}

model RegionData {
  country  String    @id
  region   String
  theatre  String?
  students Student[]

  @@map("region_data")
}

model ImportMetadata {
  key       String   @id
  timestamp DateTime @default(now())

  @@map("import_metadata")
}

enum Role {
  SuperAdmin
  Admin
  User
}

enum ProgramLevel {
  Country
  Theatre
  Global
}

model Specialisation {
  id   Int    @id @default(autoincrement())
  name String @unique

  programData ProgramData[]

  @@map("specialisations")
}

model ProgramData {
  id               Int           @id @default(autoincrement())
  programName      String        @map("program_name")
  specialisationId Int           @map("specialisation_id")
  level            ProgramLevel
  trainingType     TrainingType? @map("training_type")
  trainingTitle    String?       @map("training_title")
  quantityRequired   Int           @map("quantity_required")
  minimumPerTheatre  Int?          @map("minimum_per_theatre")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  specialisation Specialisation @relation(fields: [specialisationId], references: [id])
  trainingData   TrainingData?  @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)
  alternatives   ProgramDataAlternative[]

  @@map("program_data")
}

model ProgramDataAlternative {
  id              Int          @id @default(autoincrement())
  programDataId   Int          @map("program_data_id")
  trainingType    TrainingType @map("training_type")
  trainingTitle   String       @map("training_title")

  programData  ProgramData  @relation(fields: [programDataId], references: [id], onDelete: Cascade)
  trainingData TrainingData @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)

  @@map("program_data_alternatives")
}

model User {
  id             Int           @id @default(autoincrement())
  username       String        @unique
  passwordHash   String        @map("password_hash")
  displayName    String        @map("display_name")
  role           Role          @default(User)
  mfaEnabled     Boolean       @default(false) @map("mfa_enabled")
  mfaSecret      String?       @map("mfa_secret")
  mustEnableMfa  Boolean       @default(false) @map("must_enable_mfa")
  lastLoginAt    DateTime?     @map("last_login_at")
  lastLoginIp    String?       @map("last_login_ip")
  dateFormat     String?       @map("date_format")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  companies      UserCompany[]

  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdatedBy")

  @@map("users")
}

// Singleton: always id = 1. Stores system-wide preferences (currently just
// the default date format). Application code must upsert with id: 1; the
// migration also adds a CHECK constraint as defence-in-depth.
model SystemSetting {
  id          Int      @id @default(1)
  dateFormat  String   @default("DD/MM/YYYY") @map("date_format")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById Int?     @map("updated_by_id")

  updatedBy User? @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model ScheduledExport {
  id          Int       @id @default(autoincrement())
  name        String
  companyId   Int       @map("company_id")
  reportType  String    @map("report_type")
  format      String
  destination String
  config      Json
  enabled     Boolean   @default(true)
  frequency   String
  time        String
  dayOfWeek   Int?      @map("day_of_week")
  dayOfMonth  Int?      @map("day_of_month")
  lastRunAt   DateTime? @map("last_run_at")
  lastStatus  String?   @map("last_status")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company     Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("scheduled_exports")
}

model ExportCredential {
  id              Int       @id @default(autoincrement())
  provider        String    @unique
  config          Json
  lastCheckedAt   DateTime? @map("last_checked_at")
  lastCheckStatus String?   @map("last_check_status")
  lastCheckError  String?   @map("last_check_error")
  lastSuccessAt   DateTime? @map("last_success_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("export_credentials")
}
