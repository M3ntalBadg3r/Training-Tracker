generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TrainingType {
  Certification
  Accreditation
  InstructorLedTraining @map("Instructor-Led Training")
}

enum ProductType {
  Cortex
  SASE
  Cloud
  Strata
  Foundation
}

enum FunctionType {
  Sales
  PreSales     @map("Pre-Sales")
  Deployments
}

model Student {
  email      String          @id
  fullName   String          @map("full_name")
  theatre    String
  country    String
  regionData RegionData?     @relation(fields: [country], references: [country])
  trainings  TrainingTaken[]

  @@map("students")
}

model TrainingTaken {
  id            Int          @id @default(autoincrement())
  email         String
  trainingTitle String       @map("training_title")
  completedDate DateTime     @map("completed_date")
  expiryDate    DateTime     @map("expiry_date")

  student      Student      @relation(fields: [email], references: [email], onDelete: Cascade)
  trainingData TrainingData @relation(fields: [trainingTitle], references: [trainingTitle], onDelete: Cascade)

  @@index([email])
  @@index([trainingTitle])
  @@map("training_taken")
}

model TrainingData {
  trainingTitle String       @id @map("training_title")
  fullTitle     String       @map("full_title")
  trainingType  TrainingType @map("training_type")
  productType   ProductType  @map("product_type")
  function      FunctionType
  link          String?
  certification String[]      @default([]) @map("certification")

  trainingsTaken TrainingTaken[]

  @@index([fullTitle])
  @@map("training_data")
}

model RegionData {
  country  String    @id
  region   String
  students Student[]

  @@map("region_data")
}

model ImportMetadata {
  key       String   @id
  timestamp DateTime @default(now())

  @@map("import_metadata")
}

enum Role {
  Admin
  User
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  passwordHash  String   @map("password_hash")
  displayName   String   @map("display_name")
  role          Role     @default(User)
  mfaEnabled    Boolean  @default(false) @map("mfa_enabled")
  mfaSecret     String?  @map("mfa_secret")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ScheduledExport {
  id          Int       @id @default(autoincrement())
  name        String
  reportType  String    @map("report_type")
  format      String
  destination String
  config      Json
  enabled     Boolean   @default(true)
  frequency   String
  time        String
  dayOfWeek   Int?      @map("day_of_week")
  dayOfMonth  Int?      @map("day_of_month")
  lastRunAt   DateTime? @map("last_run_at")
  lastStatus  String?   @map("last_status")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("scheduled_exports")
}

model ExportCredential {
  id        Int      @id @default(autoincrement())
  provider  String   @unique
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("export_credentials")
}
